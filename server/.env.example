# Server Configuration
PORT=5000
NODE_ENV=development

# Core Security Origin Handlers
# ALLOWED_ORIGINS controls the CORS firewall. For Render -> Vercel, put your Vercel URL here.
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app
CLIENT_URL=http://localhost:5173

# Database Connections
MONGODB_URI=mongodb://localhost:27017/hostel_saas_db
REDIS_URL=redis://localhost:6379 

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email (SMTP)
SMTP_EMAIL=admin@hostel-saas.com
SMTP_PASSWORD=your_smtp_password

# WhatsApp Integration (Optional)
WHATSAPP_API_TOKEN=your_whatsapp_token
